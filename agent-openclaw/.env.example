ROMEO_AGENT_HOST=127.0.0.1
ROMEO_AGENT_PORT=8443
ROMEO_AGENT_CERT_FILE=$HOME/.config/romeo-agent-openclaw/tls/agent-host.your-tailnet.ts.net.crt
ROMEO_AGENT_KEY_FILE=$HOME/.config/romeo-agent-openclaw/tls/agent-host.your-tailnet.ts.net.key

ROMEO_AGENT_OPENCLAW_BIN=openclaw
ROMEO_AGENT_OPENCLAW_CWD=$HOME/.openclaw/workspace
# Set this to the existing OpenClaw session that should receive voice turns.
# Do not create a separate app session unless you intentionally want separate context.
ROMEO_AGENT_OPENCLAW_SESSION_KEY=agent:main:main
ROMEO_AGENT_OPENCLAW_TIMEOUT_SECONDS=600

# gateway = warm WebSocket to the local OpenClaw Gateway. Recommended.
# cli = cold-spawn `openclaw agent` per request. Slower; kept as fallback.
ROMEO_AGENT_OPENCLAW_TRANSPORT=gateway
ROMEO_AGENT_OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
ROMEO_AGENT_OPENCLAW_GATEWAY_FALLBACK_TO_CLI=1

# Usually leave these empty. Set only if OpenClaw is installed somewhere unusual
# or GatewayClient discovery breaks after an OpenClaw update.
ROMEO_AGENT_OPENCLAW_GATEWAY_CLIENT_MODULE=
ROMEO_AGENT_OPENCLAW_DIST_DIR=
