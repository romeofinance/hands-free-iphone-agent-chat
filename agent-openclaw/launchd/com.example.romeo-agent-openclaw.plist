<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.romeo-agent-openclaw</string>

  <key>ProgramArguments</key>
  <array>
    <string>/path/to/agent-openclaw/scripts/run-server.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/path/to/logs/romeo-agent-openclaw.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/logs/romeo-agent-openclaw.stderr.log</string>

  <key>WorkingDirectory</key>
  <string>/path/to/agent-openclaw</string>
</dict>
</plist>
